# === Discord ===
DISCORD_TOKEN=
# dev for guild sync during development (fast updates), global for production.
COMMAND_SYNC_SCOPE=global
# Your test guild ID (string). Only needed when COMMAND_SYNC_SCOPE=dev.
DISCORD_GUILD_ID=

# Optional logging/alert channels (string IDs)
LOG_CHANNEL_ID=
ALERT_CHANNEL_ID=
# Comma-separated list of admin role IDs
ADMIN_ROLE_IDS=

# --- Postgres ---
POSTGRES_DB=ptero_bot
POSTGRES_USER=ptero_bot
POSTGRES_PASSWORD=change_me_now

# === Jexpanel ===
# Base URL of the Jexpanel panel (e.g., https://panel.example.com)
PTERO_PANEL_URL=
# Application API key (for admin/estate visibility commands)
PTERO_APP_API_KEY=
# Optional fallback Client API key (use per-user keys via /link instead)
#PTERO_CLIENT_API_KEY=

# === Storage & Security ===
# SQLite path (or any SQLAlchemy URL). The container uses /data by default.
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# 32-byte encryption key for user API tokens (generate with: openssl rand -hex 32)
# IMPORTANT: Keep this secret! If compromised, all stored API keys may be at risk.
# Generate a new key: openssl rand -hex 32
ENCRYPTION_KEY=
# Purge user-linked keys that haven't been used in N days (default 7)
CRED_PURGE_DAYS=7
# Version number for encryption key rotation (default 1)
# Increment when rotating keys, then run /migrate_credentials to re-encrypt
DATA_KEY_VERSION=1
